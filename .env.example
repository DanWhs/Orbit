# ORBIT_VAULT_SECRET: Required in Vercel / multi-instance production so the 5-layer
# encrypted Gemini BYOK vault cookie remains readable across serverless invocations.
# Configure in Vercel Project Settings -> Environment Variables with a strong random secret
# (minimum 16 chars, recommended 32+ random characters). Do NOT commit real secrets.
ORBIT_VAULT_SECRET=""

# APP_URL: Optional deployment base URL (automatically injected by AI Studio or Vercel).
APP_URL=""
